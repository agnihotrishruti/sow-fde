# Place this file in the sow-for-fde folder (next to package.json), not the repo root.
# Local: copy to .env
# Deploy without login: add VERCEL_TOKEN from https://vercel.com/account/tokens then run ./scripts/deploy.sh
# If the app says the key is missing but this file has a value, your shell may export an empty
# ANTHROPIC_API_KEY — run `unset ANTHROPIC_API_KEY`. Project `.env` is loaded with override so file wins.
ANTHROPIC_API_KEY=

# Optional — deploy without `vercel login` (see README Option B)
# VERCEL_TOKEN=

# Optional override (default: claude-sonnet-4-20250514)
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# API server port — only used by `npm run dev:api` or `npm run preview` proxy (default: 3847)
PORT=3847
